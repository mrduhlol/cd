<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cd_bg">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scanner_barcode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_scanner_layout="@layout/cd_qr_scanner_viewfinder" />

    <LinearLayout
        android:id="@+id/scanner_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/cd_scanner_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/scanner_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/cd_scanner_round_button"
            android:contentDescription="@string/scanner_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_scanner_back" />

        <TextView
            android:id="@+id/scanner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/scanner_title"
            android:textColor="@color/cd_text"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/scanner_torch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/cd_scanner_toggle_button"
            android:contentDescription="@string/scanner_flash_on"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_scanner_flash"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scanner_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/cd_scanner_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/scanner_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:textColor="@color/cd_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/scanner_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@string/scanner_hint"
            android:textColor="@color/cd_scanner_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/scanner_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scanner_permission_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/scanner_permission_body"
                android:textColor="@color/cd_scanner_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/scanner_allow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/cd_scanner_primary_button"
                android:fontFamily="@font/inter_semibold"
                android:minHeight="52dp"
                android:text="@string/scanner_allow_camera"
                android:textAllCaps="false"
                android:textColor="@color/cd_bg"
                android:textSize="15sp" />

            <Button
                android:id="@+id/scanner_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/cd_scanner_secondary_button"
                android:fontFamily="@font/inter_semibold"
                android:minHeight="52dp"
                android:text="@string/scanner_open_settings"
                android:textAllCaps="false"
                android:textColor="@color/cd_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
